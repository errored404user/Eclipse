# Eclipse Community production service
# Copy these values into your hosting provider's encrypted environment settings.
# Do not commit a real .env file.

# PostgreSQL connection string. TLS is required unless COMMUNITY_DATABASE_SSL=false
# is deliberately set for a local development database.
DATABASE_URL=postgresql://eclipse:replace-me@database.example:5432/eclipse_community
COMMUNITY_DATABASE_SSL=true
# Serverless runtimes should keep this low to protect PostgreSQL connection limits.
# Valid range: 1–10. Default is 2.
COMMUNITY_DATABASE_POOL_MAX=2

# Use at least 32 random characters. Generate this once and retain it securely;
# changing it invalidates every existing session and email verification link.
COMMUNITY_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Transactional SMTP connection and an authorized sender address.
COMMUNITY_SMTP_URL=smtps://smtp-user:replace-me@smtp.example:465
COMMUNITY_EMAIL_FROM=Eclipse Community <community@example.com>

# Exact externally visible URL. Production must be HTTPS.
COMMUNITY_PUBLIC_URL=https://community.example.com

# Only set true when the immediate reverse proxy is trusted to overwrite
# X-Forwarded-For rather than passing a client-controlled header through.
COMMUNITY_TRUST_PROXY=false

# The process port; TLS terminates at a reverse proxy or hosting platform.
PORT=4173

# Optional desktop-only setting. This is a public Discord Application ID, not a secret.
# It is ignored by the Community server and can also be entered in Eclipse > Integrations.
ECLIPSE_DISCORD_CLIENT_ID=
